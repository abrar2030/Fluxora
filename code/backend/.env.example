ENV=development
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

SECRET_KEY=change-this-secret-key-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173

DATABASE_URL=sqlite:///./fluxora.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

MODEL_PATH=./fluxora_model.joblib
MODEL_N_ESTIMATORS=100
MODEL_MAX_DEPTH=
